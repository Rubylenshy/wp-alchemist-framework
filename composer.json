{
    "name": "wp-alchemist/framework",
    "description": "Runtime helpers for WordPress plugins scaffolded with wp-alchemist: lifecycle, modules, REST routing, Vite assets, migrations, settings and support helpers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "plugin",
        "framework",
        "vite",
        "rest"
    ],
    "homepage": "https://github.com/Rubylenshy/wp-alchemist",
    "support": {
        "issues": "https://github.com/Rubylenshy/wp-alchemist/issues",
        "source": "https://github.com/Rubylenshy/wp-alchemist/tree/main/packages/framework"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "WpAlchemist\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpAlchemist\\Framework\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
